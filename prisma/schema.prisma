// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  INDUSTRY
  UMKM
  ADMIN
}

enum AccountStatus {
  PENDING
  VERIFIED
  SUSPENDED
}

enum OrgType {
  INDUSTRY
  UMKM
  PLATFORM
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

enum MemberRole {
  OWNER
  MEMBER
  ADMIN
}

enum DocumentType {
  NIB
  NPWP
  IZIN_USAHA
  FOTO_BENGKEL
  AKTA
  KONTAK_PIC
}

enum DocumentStatus {
  PENDING
  VERIFIED
  REJECTED
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  passwordHash        String               @map("password_hash")
  role                Role
  status              AccountStatus        @default(PENDING)
  failedLoginAttempts Int                  @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?            @map("locked_until")
  resetToken          String?              @map("reset_token")
  resetTokenExpiry    DateTime?            @map("reset_token_expiry")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  
  organizationMembers OrganizationMember[]

  @@map("users")
}

model Organization {
  id                 String               @id @default(cuid())
  type               OrgType
  name               String
  city               String
  province           String
  address            String?
  description        String?
  yearEstablished    Int?                 @map("year_established")
  operatorCount      Int?                 @map("operator_count")
  shiftCount         Int?                 @map("shift_count")
  logoUrl            String?              @map("logo_url")
  picName            String               @map("pic_name")
  picPhone           String?              @map("pic_phone")
  verificationStatus VerificationStatus   @default(PENDING) @map("verification_status")
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")

  members            OrganizationMember[]
  documents          Document[]
  capabilities       Capability[]
  machineAssets      MachineAsset[]
  portfolioItems     PortfolioItem[]
  certifications     OrgCertification[]
  readinessSnapshots ReadinessSnapshot[]
  rfqs               Rfq[]                @relation("IndustryRfqs")
  rfqQuestionsAsked  RfqQuestion[]        @relation("RfqQuestionsAsked")
  rfqInvitations     RfqInvitation[]      @relation("RfqInvitations")

  @@map("organizations")
}

model Document {
  id              String         @id @default(cuid())
  organizationId  String         @map("organization_id")
  type            DocumentType
  fileUrl         String         @map("file_url")
  fileName        String         @map("file_name")
  fileSize        Int            @default(0) @map("file_size")
  status          DocumentStatus @default(PENDING)
  rejectionReason String?        @map("rejection_reason")
  validUntil      DateTime?      @map("valid_until")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("documents")
}

model AuditLog {
  id        String   @id @default(cuid())
  entity    String
  entityId  String   @map("entity_id")
  action    String
  actorId   String?  @map("actor_id")
  details   Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([entity, entityId])
  @@index([actorId])
  @@map("audit_logs")
}

model OrganizationMember {
  id             String       @id @default(cuid())
  userId         String       @map("user_id")
  organizationId String       @map("organization_id")
  role           MemberRole   @default(OWNER)
  createdAt      DateTime     @default(now()) @map("created_at")

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@map("organization_members")
}

model ProductCategory {
  id          String            @id @default(cuid())
  name        String
  slug        String            @unique
  description String?
  parentId    String?           @map("parent_id")
  parent      ProductCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children    ProductCategory[] @relation("CategoryHierarchy")
  capabilities Capability[]
  createdAt   DateTime          @default(now()) @map("created_at")

  @@map("product_categories")
}

model ProductionService {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("production_services")
}

model Certification {
  id                 String             @id @default(cuid())
  name               String
  issuer             String?
  description        String?
  orgCertifications  OrgCertification[]
  createdAt          DateTime           @default(now()) @map("created_at")

  @@map("certifications")
}

model Capability {
  id              String          @id @default(cuid())
  organizationId  String          @map("organization_id")
  categoryId      String          @map("category_id")
  services        String[]        @default([])
  materials       String[]        @default([])
  decorations     String[]        @default([])
  monthlyCapacity Int             @default(0) @map("monthly_capacity")
  minOrderQty     Int             @default(0) @map("min_order_qty")
  leadTimeDays    Int             @default(14) @map("lead_time_days")
  serviceArea     String?         @map("service_area")
  notes           String?
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category        ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([organizationId, categoryId])
  @@index([organizationId])
  @@index([categoryId])
  @@map("capabilities")
}

model MachineAsset {
  id              String       @id @default(cuid())
  organizationId  String       @map("organization_id")
  machineType     String       @map("machine_type")
  brand           String?
  quantity        Int          @default(1)
  condition       String?      @default("BAIK")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("machine_assets")
}

model PortfolioItem {
  id              String       @id @default(cuid())
  organizationId  String       @map("organization_id")
  title           String
  description     String?
  productType     String       @map("product_type")
  clientType      String?      @map("client_type")
  largestOrderQty Int?         @map("largest_order_qty")
  imageUrl        String       @map("image_url")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("portfolio_items")
}

model OrgCertification {
  id                String        @id @default(cuid())
  organizationId    String        @map("organization_id")
  certificationId   String        @map("certification_id")
  certificateNumber String?       @map("certificate_number")
  documentUrl       String?       @map("document_url")
  validUntil        DateTime?     @map("valid_until")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  organization      Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  certification     Certification @relation(fields: [certificationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([certificationId])
  @@map("org_certifications")
}

model ScoringConfig {
  id                  String   @id @default("default")
  // Readiness Weights (Total 100)
  readinessLegalitas  Int      @default(20) @map("readiness_legalitas")
  readinessKapasitas  Int      @default(20) @map("readiness_kapasitas")
  readinessMutu       Int      @default(20) @map("readiness_mutu")
  readinessRekamJejak Int      @default(20) @map("readiness_rekam_jejak")
  readinessAdmin      Int      @default(10) @map("readiness_admin")
  readinessFinansial  Int      @default(10) @map("readiness_finansial")

  // Matching Weights (Total 100)
  matchingKategori    Int      @default(25) @map("matching_kategori")
  matchingKapasitas   Int      @default(20) @map("matching_kapasitas")
  matchingBahan       Int      @default(15) @map("matching_bahan")
  matchingLeadTime    Int      @default(10) @map("matching_lead_time")
  matchingLokasi      Int      @default(10) @map("matching_lokasi")
  matchingReadiness   Int      @default(10) @map("matching_readiness")
  matchingReputasi    Int      @default(10) @map("matching_reputasi")

  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("scoring_configs")
}

model RecommendationRule {
  id         String   @id @default(cuid())
  component  String
  condition  String
  text       String
  points     Int
  difficulty String
  link       String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("recommendation_rules")
}

model PlatformConfig {
  id                       String   @id @default("default")
  commissionPercent        Int      @default(5) @map("commission_percent")
  minLots                  Int      @default(2) @map("min_lots")
  maxLots                  Int      @default(4) @map("max_lots")
  minLotQty                Int      @default(20) @map("min_lot_qty")
  fundingDeadlineHours     Int      @default(72) @map("funding_deadline_hours")
  autoConfirmMaterialHours Int      @default(48) @map("auto_confirm_material_hours")
  autoConfirmQcDays        Int      @default(5) @map("auto_confirm_qc_days")
  umkmInactivityGraceHours Int      @default(72) @map("umkm_inactivity_grace_hours")
  disputeClaimWindowDays   Int      @default(5) @map("dispute_claim_window_days")
  cancellationFeePercent   Int      @default(2) @map("cancellation_fee_percent")
  compensationMatrix       Json?    @map("compensation_matrix")
  updatedAt                DateTime @updatedAt @map("updated_at")

  @@map("platform_configs")
}

model ReadinessSnapshot {
  id              String       @id @default(cuid())
  organizationId  String       @map("organization_id")
  totalScore      Int          @default(0) @map("total_score")
  tier            String       @default("TAHAP_AWAL")
  componentScores Json         @map("component_scores")
  calculatedAt    DateTime     @default(now()) @map("calculated_at")

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, calculatedAt(sort: Desc)])
  @@map("readiness_snapshots")
}

enum RfqCategoryType {
  SERAGAM
  MERCHANDISE
  MAKLON
}

enum RfqVisibility {
  TERBUKA
  UNDANGAN
}

enum RfqAllocationMode {
  TUNGGAL
  LOT
}

enum RfqStatus {
  DRAFT
  OPEN
  CLOSED
  EVALUATING
  SAMPLING
  AWARDED
  AWARDED_PARTIAL
  EXPIRED
  CANCELLED
}

model Rfq {
  id                      String            @id @default(cuid())
  rfqNumber               String            @unique @map("rfq_number")
  industryOrgId           String            @map("industry_org_id")
  title                   String
  categoryType            RfqCategoryType   @default(SERAGAM) @map("category_type")
  visibility              RfqVisibility     @default(TERBUKA)
  contextDescription      String?           @map("context_description") @db.Text
  allocationMode          RfqAllocationMode @default(TUNGGAL) @map("allocation_mode")
  maxLotsPerUmkm          Int               @default(1) @map("max_lots_per_umkm")
  materialConsistencyRule String?           @map("material_consistency_rule")
  referenceStandard       Json?             @map("reference_standard")
  pricePolicy             String?           @map("price_policy")
  needSample              Boolean           @default(false) @map("need_sample")
  sampleCostBearer        String?           @map("sample_cost_bearer")
  sampleCount             Int?              @map("sample_count")
  sampleDeadlineDays      Int?              @map("sample_deadline_days")
  qaDeadline              DateTime?         @map("qa_deadline")
  quotationDeadline       DateTime          @map("quotation_deadline")
  targetDeliveryDate      DateTime          @map("target_delivery_date")
  deliveryLocation        String            @map("delivery_location")
  staggeredDelivery       Boolean           @default(false) @map("staggered_delivery")
  releaseTerms            Json?             @map("release_terms")
  latePenaltyClause       String?           @map("late_penalty_clause")
  indicativeBudget        BigInt?           @map("indicative_budget")
  hideBudget              Boolean           @default(false) @map("hide_budget")
  evaluationWeights       Json?             @map("evaluation_weights")
  cancelReason            String?           @map("cancel_reason") @db.Text
  status                  RfqStatus         @default(DRAFT)
  createdAt               DateTime          @default(now()) @map("created_at")
  updatedAt               DateTime          @updatedAt @map("updated_at")

  industryOrg             Organization      @relation("IndustryRfqs", fields: [industryOrgId], references: [id], onDelete: Cascade)
  items                   RfqItem[]
  requirements            RfqRequirement[]
  questions               RfqQuestion[]
  addendums               RfqAddendum[]
  invitations             RfqInvitation[]

  @@index([industryOrgId])
  @@index([status])
  @@index([quotationDeadline])
  @@map("rfqs")
}

model RfqItem {
  id                       String        @id @default(cuid())
  rfqId                    String        @map("rfq_id")
  name                     String
  categoryId               String?       @map("category_id")
  fabricType               String        @map("fabric_type")
  gsmMin                   Int?          @map("gsm_min")
  gsmMax                   Int?          @map("gsm_max")
  color                    String
  materialProvidedByBuyer  Boolean       @default(false) @map("material_provided_by_buyer")
  techPackUrl              String?       @map("tech_pack_url")
  referencePhotoUrl        String?       @map("reference_photo_url")
  constructionNotes        String?       @map("construction_notes") @db.Text
  decorationType           String?       @map("decoration_type")
  decorationPlacement      String?       @map("decoration_placement")
  decorationFileUrl        String?       @map("decoration_file_url")
  labelPackingNotes        String?       @map("label_packing_notes")
  quantityTolerancePercent Float?        @map("quantity_tolerance_percent")
  dimensionTolerance       String?       @map("dimension_tolerance")
  aqlStandard              String?       @map("aql_standard")
  needLabTest              Boolean       @default(false) @map("need_lab_test")
  totalQuantity            Int           @map("total_quantity")
  createdAt                DateTime      @default(now()) @map("created_at")
  updatedAt                DateTime      @updatedAt @map("updated_at")

  rfq                      Rfq           @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  sizes                    RfqItemSize[]

  @@index([rfqId])
  @@map("rfq_items")
}

model RfqItemSize {
  id        String  @id @default(cuid())
  rfqItemId String  @map("rfq_item_id")
  size      String
  quantity  Int

  item      RfqItem @relation(fields: [rfqItemId], references: [id], onDelete: Cascade)

  @@index([rfqItemId])
  @@map("rfq_item_sizes")
}

model RfqRequirement {
  id          String  @id @default(cuid())
  rfqId       String  @map("rfq_id")
  type        String
  description String
  isMandatory Boolean @default(true) @map("is_mandatory")

  rfq         Rfq     @relation(fields: [rfqId], references: [id], onDelete: Cascade)

  @@index([rfqId])
  @@map("rfq_requirements")
}

model RfqQuestion {
  id         String       @id @default(cuid())
  rfqId      String       @map("rfq_id")
  askerOrgId String       @map("asker_org_id")
  question   String       @db.Text
  answer     String?      @db.Text
  answeredAt DateTime?    @map("answered_at")
  createdAt  DateTime     @default(now()) @map("created_at")

  rfq        Rfq          @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  askerOrg   Organization @relation("RfqQuestionsAsked", fields: [askerOrgId], references: [id], onDelete: Cascade)

  @@index([rfqId])
  @@index([askerOrgId])
  @@map("rfq_questions")
}

model RfqAddendum {
  id             String   @id @default(cuid())
  rfqId          String   @map("rfq_id")
  addendumNumber Int      @map("addendum_number")
  summary        String   @db.Text
  changes        Json?
  createdAt      DateTime @default(now()) @map("created_at")

  rfq            Rfq      @relation(fields: [rfqId], references: [id], onDelete: Cascade)

  @@unique([rfqId, addendumNumber])
  @@index([rfqId])
  @@map("rfq_addendums")
}

model RfqInvitation {
  id        String       @id @default(cuid())
  rfqId     String       @map("rfq_id")
  umkmOrgId String       @map("umkm_org_id")
  invitedAt DateTime     @default(now()) @map("invited_at")

  rfq       Rfq          @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  umkmOrg   Organization @relation("RfqInvitations", fields: [umkmOrgId], references: [id], onDelete: Cascade)

  @@unique([rfqId, umkmOrgId])
  @@index([rfqId])
  @@index([umkmOrgId])
  @@map("rfq_invitations")
}
