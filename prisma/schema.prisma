// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  INDUSTRY
  UMKM
  ADMIN
}

enum AccountStatus {
  PENDING
  VERIFIED
  SUSPENDED
}

enum OrgType {
  INDUSTRY
  UMKM
  PLATFORM
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

enum MemberRole {
  OWNER
  MEMBER
  ADMIN
}

enum DocumentType {
  NIB
  NPWP
  IZIN_USAHA
  FOTO_BENGKEL
  AKTA
  KONTAK_PIC
}

enum DocumentStatus {
  PENDING
  VERIFIED
  REJECTED
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  passwordHash        String               @map("password_hash")
  role                Role
  status              AccountStatus        @default(PENDING)
  failedLoginAttempts Int                  @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?            @map("locked_until")
  resetToken          String?              @map("reset_token")
  resetTokenExpiry    DateTime?            @map("reset_token_expiry")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  
  organizationMembers OrganizationMember[]

  @@map("users")
}

model Organization {
  id                 String               @id @default(cuid())
  type               OrgType
  name               String
  city               String
  province           String
  address            String?
  picName            String               @map("pic_name")
  picPhone           String?              @map("pic_phone")
  verificationStatus VerificationStatus   @default(PENDING) @map("verification_status")
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")

  members            OrganizationMember[]
  documents          Document[]

  @@map("organizations")
}

model Document {
  id              String         @id @default(cuid())
  organizationId  String         @map("organization_id")
  type            DocumentType
  fileUrl         String         @map("file_url")
  fileName        String         @map("file_name")
  fileSize        Int            @default(0) @map("file_size")
  status          DocumentStatus @default(PENDING)
  rejectionReason String?        @map("rejection_reason")
  validUntil      DateTime?      @map("valid_until")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("documents")
}

model AuditLog {
  id        String   @id @default(cuid())
  entity    String
  entityId  String   @map("entity_id")
  action    String
  actorId   String?  @map("actor_id")
  details   Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([entity, entityId])
  @@index([actorId])
  @@map("audit_logs")
}

model OrganizationMember {
  id             String       @id @default(cuid())
  userId         String       @map("user_id")
  organizationId String       @map("organization_id")
  role           MemberRole   @default(OWNER)
  createdAt      DateTime     @default(now()) @map("created_at")

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@map("organization_members")
}

model ProductCategory {
  id          String            @id @default(cuid())
  name        String
  slug        String            @unique
  description String?
  parentId    String?           @map("parent_id")
  parent      ProductCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children    ProductCategory[] @relation("CategoryHierarchy")
  createdAt   DateTime          @default(now()) @map("created_at")

  @@map("product_categories")
}

model ProductionService {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("production_services")
}

model Certification {
  id          String   @id @default(cuid())
  name        String
  issuer      String?
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("certifications")
}

model ScoringConfig {
  id                  String   @id @default("default")
  // Readiness Weights (Total 100)
  readinessLegalitas  Int      @default(20) @map("readiness_legalitas")
  readinessKapasitas  Int      @default(20) @map("readiness_kapasitas")
  readinessMutu       Int      @default(20) @map("readiness_mutu")
  readinessRekamJejak Int      @default(20) @map("readiness_rekam_jejak")
  readinessAdmin      Int      @default(10) @map("readiness_admin")
  readinessFinansial  Int      @default(10) @map("readiness_finansial")

  // Matching Weights (Total 100)
  matchingKategori    Int      @default(25) @map("matching_kategori")
  matchingKapasitas   Int      @default(20) @map("matching_kapasitas")
  matchingBahan       Int      @default(15) @map("matching_bahan")
  matchingLeadTime    Int      @default(10) @map("matching_lead_time")
  matchingLokasi      Int      @default(10) @map("matching_lokasi")
  matchingReadiness   Int      @default(10) @map("matching_readiness")
  matchingReputasi    Int      @default(10) @map("matching_reputasi")

  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("scoring_configs")
}

model RecommendationRule {
  id         String   @id @default(cuid())
  component  String
  condition  String
  text       String
  points     Int
  difficulty String
  link       String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("recommendation_rules")
}

model PlatformConfig {
  id                       String   @id @default("default")
  commissionPercent        Int      @default(5) @map("commission_percent")
  minLots                  Int      @default(2) @map("min_lots")
  maxLots                  Int      @default(4) @map("max_lots")
  minLotQty                Int      @default(20) @map("min_lot_qty")
  fundingDeadlineHours     Int      @default(72) @map("funding_deadline_hours")
  autoConfirmMaterialHours Int      @default(48) @map("auto_confirm_material_hours")
  autoConfirmQcDays        Int      @default(5) @map("auto_confirm_qc_days")
  umkmInactivityGraceHours Int      @default(72) @map("umkm_inactivity_grace_hours")
  disputeClaimWindowDays   Int      @default(5) @map("dispute_claim_window_days")
  cancellationFeePercent   Int      @default(2) @map("cancellation_fee_percent")
  compensationMatrix       Json?    @map("compensation_matrix")
  updatedAt                DateTime @updatedAt @map("updated_at")

  @@map("platform_configs")
}
