# Salin menjadi .env lalu isi. JANGAN commit .env.
# Database (PostgreSQL / Neon - gunakan DIRECT_URL untuk migrasi tanpa pooler)
DATABASE_URL="postgresql://user:password@ep-xyz-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xyz.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Auth.js
AUTH_SECRET="" # buat dengan: openssl rand -base64 32
AUTH_URL="http://localhost:3000"

# File storage (pilih satu penyedia)
STORAGE_PROVIDER="cloudinary" # cloudinary | supabase | s3
CLOUDINARY_URL=""

# Email
RESEND_API_KEY=""
EMAIL_FROM="RantaiNaik <no-reply@example.com>"

# Escrow Fase 1 = simulasi (tanpa uang sungguhan)
ESCROW_PROVIDER="simulated"

# Job terjadwal
CRON_SECRET=""
